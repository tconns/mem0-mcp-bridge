# URL API Mem0 (đã deploy ở deploy/mem0-dokploy)
# Public (khuyến nghị — hoạt động giữa 2 Compose service Dokploy):
MEM0_API_URL=https://mem0-api.ten-ban.com

# API key từ Mem0 Dashboard (m0sk_...)
MEM0_API_KEY=m0sk_...

# Memory chung legacy cho mọi AI agent
MEM0_DEFAULT_USER_ID=team-shared

# Multica Agentic scoped memory defaults
MEM0_DEFAULT_ORG=multica
MEM0_DEFAULT_PRODUCT=multica
MEM0_DEFAULT_PROJECT=ai-agentic

# Budget gate: tiết kiệm embedding/token, tránh lưu chat/log dài
MEM0_MAX_MEMORY_CHARS=1500
MEM0_MIN_IMPORTANCE_TO_SAVE=3
MEM0_DEDUP_SEARCH_TOP_K=5

# Project-scoped MCP auth
# Format: org:product:project:token[:repo],org:product:project:token[:repo]
# Token nào chỉ được đọc/ghi đúng org/product/project/repo đó.
MCP_PROJECT_TOKENS=multica:multica:ai-agentic:change-me-agentic-token,multica:multica:sim-manager:change-me-sim-token

# Chỉ bật true khi dev local. Production nên false.
MCP_ALLOW_UNAUTHENTICATED=false

# Delete theo memory_id không tự xác minh scope được; production nên false.
MCP_ALLOW_CROSS_SCOPE_DELETE=false
